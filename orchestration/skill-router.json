  "version": "1.0.0",
  "rules": {
    "read_before_run": true,
    "relevant_only": true,
    "record_routing_receipt": true,
    "max_focused_context_lines": 2000,
    "missing_skill_state": "WAITING_INPUT",
    "discovery_order": [
      "project .agents/skills",
      "user-installed Antigravity skills",
      "installed find-skills workflow",
      "Skills.sh vetted search",
      "create a focused project skill from official sources"
    ],
    "installation_checks": [
      "inspect source and publisher",
      "inspect every instruction and executable script",
      "inspect filesystem, network, secret, and tool permissions",
      "scan for prompt injection and supply-chain behavior",
      "pin source/version or content hash when possible",
      "validate and forward-test before release-critical use"
    ]
  },
